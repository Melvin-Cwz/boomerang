#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 MelvinCwz

%:
	dh $@ --buildsystem=meson

# User units: only boomerangd is enabled for every user (postinst). The iCloud
# Drive and iCloud Photos mounts are enabled by Boomerang per user, after sign-in.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable

# The Wingpanel indicator is an add-on copied into Wingpanel's directory on request
# (bin/boomerang-wingpanel-addon.in): its libraries come with Wingpanel, not with Boomerang.
# Granite is left out of the computed dependencies: the package carries a Granite 9 and a
# Granite 7 build and needs only one of the two libraries (see Depends in debian/control).
override_dh_shlibdeps:
	dh_shlibdeps -X libboomerang-indicator.so -- -xlibgranite9 -xlibgranite7 -xlibgranite-7-7

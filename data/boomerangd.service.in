[Unit]
Description=Boomerang daemon (iPhone link: notifications, media, calls, battery, iCloud)
Documentation=file://@PKGDATADIR@
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service

[Service]
Type=dbus
BusName=io.github.melvincouwez.Boomerang.Daemon
ExecStart=@BINDIR@/boomerangd
Restart=on-failure
RestartSec=5
# A hung main loop stops the pings (util.start_watchdog): systemd restarts it.
WatchdogSec=30
NotifyAccess=main
# Logs never contain notification text, phone numbers or secrets.

[Install]
WantedBy=graphical-session.target
